# Variables de entorno de ejemplo. Copiar a .env.local y completar cuando se
# conecten los servicios reales (ninguno está conectado en este esqueleto).

# Backend / base de datos (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Proveedor de IA (Copiloto / Agentes)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Calendario
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Pagos
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
